# A .pubignore replaces the root .gitignore when publishing, so the entries
# below repeat it before excluding repository-only files.

# Same as .gitignore
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
*.iml
*.ipr
*.iws
.idea/
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/

# Repository-only files: GitHub configuration, README artwork (which the
# README loads from GitHub) and the release-please setup.
/.github/
/.editorconfig
/.gitattributes
/.release-please-manifest.json
/release-please-config.json
